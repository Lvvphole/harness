{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/candidate.schema.json",
  "title": "SourceCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "contract_id", "language", "path", "source"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "kind": { "type": "string", "const": "candidate" },
    "contract_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "enum": ["python", "json", "text"] },
    "path": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+$" },
    "source": { "type": "string" }
  }
}
