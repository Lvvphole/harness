{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/contract.schema.json",
  "title": "TypedTaskContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "task_type",
    "allowed_paths",
    "allowed_tools",
    "allowed_commands",
    "oracles",
    "budget",
    "predicates"
  ],
  "properties": {
    "contract_id": { "type": "string" },
    "task_type": {
      "type": "string",
      "enum": [
        "feature-development",
        "bug-fix",
        "review-repair",
        "refactor",
        "testing",
        "documentation"
      ]
    },
    "allowed_paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string", "enum": ["read_file", "write_file", "run_command", "run_oracle"] }
    },
    "allowed_commands": { "type": "array", "items": { "type": "string" } },
    "oracles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "cmd", "expect_exit"],
        "properties": {
          "id": { "type": "string" },
          "cmd": { "type": "string" },
          "expect_exit": { "type": "integer" }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_files", "max_turns", "max_retries", "timeout_s"],
      "properties": {
        "max_files": { "type": "integer", "minimum": 0 },
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "timeout_s": { "type": "integer", "minimum": 1 }
      }
    },
    "predicates": {
      "type": "object",
      "required": [
        "forbid_new_files",
        "forbid_version_bump",
        "forbid_public_export_growth",
        "net_non_positive_lines",
        "one_file_scope"
      ],
      "properties": {
        "forbid_new_files": { "type": "boolean" },
        "forbid_version_bump": { "type": "boolean" },
        "forbid_public_export_growth": { "type": "boolean" },
        "net_non_positive_lines": { "type": "boolean" },
        "one_file_scope": { "type": "boolean" }
      }
    }
  }
}
