{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/proposal.schema.json",
  "title": "ProposalEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "intent", "edits", "tool_calls"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "contract_id": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "enum": ["edit", "tool", "noop"] },
    "edits": {
      "type": "array",
      "items": { "$ref": "#/$defs/edit" }
    },
    "tool_calls": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool_call" }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "unified_diff"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "enum": ["modify", "create", "delete"] },
        "unified_diff": { "type": "string" }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "args"],
      "properties": {
        "name": { "type": "string", "enum": ["read_file", "write_file", "run_command", "run_oracle"] },
        "args": { "type": "object" }
      }
    }
  }
}
