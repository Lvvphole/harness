{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/decision.schema.json",
  "title": "GateDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "attempt",
    "proposal_sha256",
    "contract_id",
    "gates",
    "decision",
    "write_authorized"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "proposal_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contract_id": { "type": "string" },
    "kind": { "type": "string", "enum": ["candidate", "edit"] },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parse_compile",
        "scope",
        "secrets",
        "injection",
        "contract_preview",
        "retry_policy"
      ],
      "properties": {
        "parse_compile": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
        "scope": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
        "secrets": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
        "injection": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
        "contract_preview": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
        "retry_policy": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] }
      }
    },
    "decision": { "type": "string", "enum": ["ACCEPT", "REJECT", "HALT"] },
    "write_authorized": { "type": "boolean" },
    "reasons": { "type": "array", "items": { "type": "string" } }
  }
}
